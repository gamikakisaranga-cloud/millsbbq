<%- include('partials/head', { title: `${recipe.title} | Mills Smoke & Grill`, description: recipe.summary || 'A Mills Smoke & Grill recipe.' }) %>
<%- include('partials/header', { page: 'recipes' }) %>
<section class="page-hero"><div class="container page-hero__inner"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/recipes">Recipes</a> / <%= recipe.title %></div><span class="eyebrow">From the Mills smokehouse</span><h1 class="display display--xl"><%= recipe.title %></h1><p class="lead"><%= recipe.summary || '' %></p></div><img class="page-hero__logo" src="<%= recipe.mainImageUrl || '/assets/images/logo-color.png' %>" alt="<%= recipe.title %>" aria-hidden="true"></section>
<section class="section"><div class="container"><div class="grid value-grid"><article class="value-card"><h3>Prep</h3><p><%= recipe.prepTime || '—' %></p></article><article class="value-card"><h3>Cook</h3><p><%= recipe.cookTime || '—' %></p></article><article class="value-card"><h3>Serves</h3><p><%= recipe.servings || '—' %></p></article></div><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:40px;margin-top:50px"><div><h2 class="display display--md">Ingredients</h2><ul><% (recipe.ingredients||[]).forEach(x=>{ %><li><%= x %></li><% }) %></ul></div><div><h2 class="display display--md">Method</h2><ol><% (recipe.method||[]).forEach(x=>{ %><li style="margin-bottom:14px"><%= x %></li><% }) %></ol></div></div><% if(recipe.body){ %><p class="lead" style="margin-top:32px;white-space:pre-line"><%= recipe.body %></p><% } %><% if(recipe.galleryImages&&recipe.galleryImages.length){ %><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:40px"><% recipe.galleryImages.forEach((src,i)=>{ %><img src="<%= src %>" alt="<%= recipe.title %> step <%= i+1 %>" loading="lazy" style="width:100%;border-radius:12px;object-fit:cover;aspect-ratio:4/3"><% }) %></div><% } %></div></section>
<%- include('partials/footer') %>
