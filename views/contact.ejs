<%- include('partials/head', { title: 'Contact | Mills Smoke & Grill', description: 'Contact Mills Smoke & Grill for product, order and wholesale enquiries.' }) %>
<%- include('partials/header', { page: 'contact' }) %>
<section class="page-hero"><div class="container page-hero__inner"><div class="breadcrumbs reveal"><a href="/">Home</a> / Contact</div><span class="eyebrow reveal reveal-delay-1">Talk to the smokehouse</span><h1 class="display display--xl reveal reveal-delay-2">Let’s fire it up.</h1><p class="lead reveal reveal-delay-3">Questions about products, orders, wholesale supply or collaborations? Send a message.</p></div><img class="page-hero__logo" src="/assets/images/logo-color.png" alt="" aria-hidden="true"></section>
<section class="section"><div class="container contact-grid"><aside class="contact-panel reveal"><span class="eyebrow">Contact details</span><h2 class="display display--md">Around the fire.</h2><p class="muted">Replace the placeholder email, phone and address below with the confirmed business details before launch.</p><div class="contact-list"><div class="contact-item"><span class="contact-item__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 5h18v14H3z"/><path d="m3 7 9 7 9-7"/></svg></span><div><small>Email</small><strong>inquiries@millsbbq.com.au</strong></div></div><div class="contact-item"><span class="contact-item__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-4-2-2 3c-4-1.5-7.5-5-9-9l3-2-2-4Z"/></svg></span><div><small>Phone</small><strong>+1 (000) 000-0000</strong></div></div><div class="contact-item"><span class="contact-item__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div><small>Location</small><strong>Add business location</strong></div></div><div class="contact-item"><span class="contact-item__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg></span><div><small>Support</small><strong>Monday–Saturday</strong></div></div></div><div class="socials"><a href="https://www.facebook.com/MillsSmokeAndGrill/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v2H6v4h3v9h4v-9h3.2l.8-4H13V9c0-.7.3-1 1-1Z"/></svg></a><a href="https://www.instagram.com/mills_smoke_and_grill/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></div></aside><div class="contact-panel reveal reveal-delay-1"><span class="eyebrow">Send a message</span><h2 class="display display--md">What can we help with?</h2><form class="form-grid" id="contact-form" data-success="Your enquiry has been sent to the Mills Smoke & Grill team."><div class="field"><label for="name">Name</label><input id="name" name="name" required></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required></div><div class="field"><label for="subject">Subject</label><select id="subject" name="subject"><option>Product question</option><option>Order support</option><option>Wholesale enquiry</option><option>Collaboration</option></select></div><div class="field"><label for="order">Order number</label><input id="order" name="order" placeholder="Optional"></div><div class="field field--full"><label for="message">Message</label><textarea id="message" name="message" required></textarea></div><div class="field field--full"><button class="btn btn--primary" type="submit">Send message <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></button></div></form></div></div></section>
<section class="section section--line" id="faq"><div class="container"><div class="section-head"><div><span class="eyebrow">Quick answers</span><h2 class="display display--lg">Frequently asked.</h2></div></div><div class="faq-grid"><div class="faq"><button type="button"><span>How much rub should I use?</span><span>+</span></button><div class="faq__answer">A useful starting point is approximately one tablespoon per 500 g of meat. Adjust based on surface area and flavour preference.</div></div><div class="faq"><button type="button"><span>How should the rubs be stored?</span><span>+</span></button><div class="faq__answer">Keep the jar tightly sealed in a cool, dry place away from direct sunlight and steam.</div></div><div class="faq"><button type="button"><span>Do you offer wholesale supply?</span><span>+</span></button><div class="faq__answer">The website is prepared for wholesale enquiries. Add the final minimum order quantities and trade pricing before launch.</div></div><div class="faq"><button type="button"><span>Can I send a gift box?</span><span>+</span></button><div class="faq__answer">Yes. Bundle products can be presented as gift boxes, with gift messages added during checkout once enabled.</div></div></div></div></section>
<script>
  document.getElementById('contact-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    var payload = Object.fromEntries(new FormData(form).entries());
    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (res) { return res.json().then(function(data){ if(!res.ok) throw new Error(data.error || 'Unable to send your enquiry.'); return data; }); })
      .then(function (data) {
        form.reset();
        var toast = document.getElementById('toast');
        if (toast) {
          toast.textContent = data.message || form.dataset.success || 'Message sent.';
          toast.classList.add('show');
          setTimeout(function () { toast.classList.remove('show'); }, 2600);
        }
      })
      .catch(function () {
        alert('Something went wrong sending your message. Please try again.');
      });
  });
</script>
<%- include('partials/footer') %>
