async function orderDetail(id){const d=await api('/api/admin/orders/'+id);const o=d.order;const panel=$('#order-detail');panel.hidden=false;panel.innerHTML=`<div class="erp-panel-head"><div><small>ORDER DETAILS</small><h2>${esc(o.orderNumber)}</h2></div><button class="erp-link" id="close-order">Close ×</button></div><p>${esc(o.first_name)} ${esc(o.last_name)} · ${esc(o.email)} · ${esc(o.address)}, ${esc(o.city)} ${esc(o.postcode)}</p><div class="erp-table-wrap"><table><thead><tr><th>ITEM</th><th>SKU</th><th>QTY</th><th>PRICE</th></tr></thead><tbody>${d.items.map(i=>`<tr><td>${esc(i.name)}</td><td>${esc(i.productId)}</td><td>${i.quantity}</td><td>${money(i.priceCents)}</td></tr>`).join('')}</tbody></table></div><p>Subtotal ${money(o.subtotalCents)} · Shipping ${money(o.shippingCents)} · Total <b>${money(o.totalCents)}</b></p><div class="erp-grid-2"><div>${field('Carrier','carrier','text',o.carrier||'')}${field('Tracking number','trackingNumber','text',o.trackingNumber||'')}<div class="erp-field"><label>Fulfilment status</label><select name="status" id="fulfilment-status">${['UNFULFILLED','PROCESSING','PACKED','SHIPPED','DELIVERED','CANCELLED'].map(s=>`<option ${s===o.fulfilment_status?'selected':''}>${s}</option>`).join('')}</select></div><button class="erp-button" id="save-fulfilment">Update fulfilment</button><p><button class="erp-button secondary" id="resend-order-email">Resend confirmation email</button> <button class="erp-button secondary" id="issue-refund">Issue refund</button></p></div><div><b>Timeline</b>${d.events.map(e=>`<p class="erp-muted">${new Date(e.created_at).toLocaleString()} · ${esc(e.description)}</p>`).join('')}</div></div>`;$('#close-order').onclick=()=>panel.hidden=true;$('#resend-order-email').onclick=async()=>{await api('/api/admin/orders/'+id+'/resend-confirmation',{method:'POST',body:JSON.stringify({})});say('Confirmation email sent.');};$('#issue-refund').onclick=async()=>{const amount=prompt('Refund amount in AUD (e.g. 12.50):');if(!amount)return;const cents=Math.round(Number(amount)*100);if(!Number.isFinite(cents)||cents<=0)return say('Enter a valid refund amount.');const reason=prompt('Refund reason (optional):')||'';await api('/api/admin/orders/'+id+'/refunds',{method:'POST',body:JSON.stringify({amountCents:cents,reason})});say('Refund submitted to Adyen; awaiting provider confirmation.');};$('#save-fulfilment').onclick=async()=>{await api('/api/admin/orders/'+id+'/fulfilment',{method:'PATCH',body:JSON.stringify({status:$('#fulfilment-status').value,carrier:panel.querySelector('[name=carrier]').value,trackingNumber:panel.querySelector('[name=trackingNumber]').value})});say('Fulfilment updated.');await loadOrders();};}
async function loadCustomers(){const d=await api('/api/admin/customers');cache.customers=d.customers;drawCustomers();}function drawCustomers(){const q=($('#customer-search')?.value||'').toLowerCase();$('#admin-customers').innerHTML=cache.customers.filter(c=>[c.firstName,c.lastName,c.email].join(' ').toLowerCase().includes(q)).map(c=>`<tr><td>${esc(c.firstName)} ${esc(c.lastName)}</td><td>${esc(c.email)}</td><td>${esc(c.phone||'—')}</td><td>${c.orderCount}</td><td>${new Date(c.createdAt).toLocaleDateString()}</td><td><button class="erp-table-action" data-customer="${esc(c.id)}">View</button></td></tr>`).join('');}
