async function loadSettings(){const d=await api('/api/admin/settings');const store=d.settings.find(s=>s.key==='store')?.value||{};$('#settings-list').innerHTML=`<form id="store-settings-form" class="form-grid">${field('Currency','currency','text',store.currency||'AUD')}${field('Timezone','timezone','text',store.timezone||'Australia/Melbourne')}${field('Free shipping threshold (AUD)','freeShipping','number',((store.freeShippingThresholdCents||15000)/100).toFixed(2),'min="0" step="0.01"')}${field('Flat delivery (AUD)','delivery','number',((store.flatDeliveryCents||1500)/100).toFixed(2),'min="0" step="0.01"')}<button class="erp-button">Save store settings</button></form><div class="erp-muted">Other saved settings: ${d.settings.filter(s=>s.key!=='store').map(s=>esc(s.key)).join(', ')||'none'}</div>`;$('#store-settings-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target);await api('/api/admin/settings/store',{method:'PUT',body:JSON.stringify({value:{currency:f.get('currency'),timezone:f.get('timezone'),freeShippingThresholdCents:Math.round(Number(f.get('freeShipping'))*100),flatDeliveryCents:Math.round(Number(f.get('delivery'))*100),deliveryCountry:'Australia'}})});say('Store settings saved.');};const status=await api('/api/payments/adyen/config').catch(e=>({ok:false,error:e.message}));$('#integration-status').innerHTML=`<div class="erp-status-item"><span>Adyen payment gateway</span><b>${status.ok?'Configured':'Not configured'}</b></div><div class="erp-status-item"><span>Cloudinary image storage</span><b>${(await api('/api/admin/uploads/cloudinary-signature').then(()=>true).catch(()=>false))?'Configured':'Not configured'}</b></div>`;}
