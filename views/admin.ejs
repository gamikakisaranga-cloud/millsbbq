let recipeCache=[];
async function uploadRecipeImage(file){if(!file||!file.size)return '';const sig=await api('/api/admin/uploads/cloudinary-signature?type=recipes');const fd=new FormData();fd.append('file',file);fd.append('api_key',sig.apiKey);fd.append('timestamp',sig.timestamp);fd.append('folder',sig.folder);fd.append('signature',sig.signature);const response=await fetch(`https://api.cloudinary.com/v1_1/${sig.cloudName}/image/upload`,{method:'POST',body:fd});const data=await response.json();if(!response.ok)throw Error(data.error?.message||'Recipe image upload failed.');return data.secure_url;}
async function loadRecipes(){const d=await api('/api/admin/recipes');recipeCache=d.recipes;$('#recipe-list').innerHTML=d.recipes.map(r=>`<tr><td><img class="erp-product-img" src="${esc(r.mainImageUrl||'')}" alt=""><b>${esc(r.title)}</b></td><td>${esc(r.prepTime||'—')}</td><td>${esc(r.cookTime||'—')}</td><td><span class="erp-badge">${esc(r.status)}</span></td><td><button class="erp-table-action" data-edit-recipe="${esc(r.id)}">Edit</button> <button class="erp-table-action" data-delete-recipe="${esc(r.id)}">Delete</button></td></tr>`).join('')||'<tr><td colspan="5">No recipes yet. Add your first recipe.</td></tr>';}
function recipeDialog(recipe){const r=recipe||{};showDialog(recipe?'Edit recipe':'Add recipe',field('Recipe title','title','text',r.title||'','required')+field('Short description','summary','text',r.summary||'')+field('Prep time','prepTime','text',r.prepTime||'')+field('Cook time','cookTime','text',r.cookTime||'')+field('Servings','servings','text',r.servings||'')+field('Mills rub pairing','rubPairing','text',r.rubPairing||'')+`<div class="erp-field"><label>Main / hero image ${recipe?'(choose a new file to replace)':'(required)'}</label><input name="mainImage" type="file" accept="image/*" ${recipe?'':'required'}></div><div class="erp-field"><label>Additional gallery images (select multiple)</label><input name="galleryFiles" type="file" accept="image/*" multiple></div><div class="erp-field"><label>Existing gallery image URLs (one per line)</label><textarea name="galleryUrls">${esc((r.galleryImages||[]).join('\n'))}</textarea></div><div class="erp-field"><label>Ingredients (one per line)</label><textarea name="ingredients">${esc((r.ingredients||[]).join('\n'))}</textarea></div><div class="erp-field"><label>Method steps (one per line)</label><textarea name="method">${esc((r.method||[]).join('\n'))}</textarea></div><div class="erp-field"><label>Additional notes</label><textarea name="body">${esc(r.body||'')}</textarea></div><div class="erp-field"><label>Publication status</label><select name="status"><option value="DRAFT" ${r.status==='DRAFT'?'selected':''}>Draft</option><option value="PUBLISHED" ${r.status==='PUBLISHED'?'selected':''}>Published</option></select></div>`,async f=>{const mainFile=f.get('mainImage');let mainImageUrl=r.mainImageUrl||'';if(mainFile?.size)mainImageUrl=await uploadRecipeImage(mainFile);if(!mainImageUrl)throw Error('Please upload a main recipe image.');const gallery=(f.get('galleryUrls')||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean);for(const file of [...f.getAll('galleryFiles')])if(file?.size)gallery.push(await uploadRecipeImage(file));const payload={title:f.get('title'),summary:f.get('summary'),prepTime:f.get('prepTime'),cookTime:f.get('cookTime'),servings:f.get('servings'),rubPairing:f.get('rubPairing'),mainImageUrl,galleryImages:gallery,ingredients:f.get('ingredients').split(/\r?\n/).map(x=>x.trim()).filter(Boolean),method:f.get('method').split(/\r?\n/).map(x=>x.trim()).filter(Boolean),body:f.get('body'),status:f.get('status')};await api(recipe?'/api/admin/recipes/'+recipe.id:'/api/admin/recipes',{method:recipe?'PATCH':'POST',body:JSON.stringify(payload)});await loadRecipes();});}
$('#new-recipe').onclick=()=>recipeDialog(null);
$('#recipe-list').onclick=async e=>{const edit=e.target.closest('[data-edit-recipe]'),del=e.target.closest('[data-delete-recipe]');if(edit){const recipe=recipeCache.find(r=>r.id===edit.dataset.editRecipe);if(recipe)recipeDialog(recipe);}if(del){const recipe=recipeCache.find(r=>r.id===del.dataset.deleteRecipe);if(recipe&&confirm(`Delete recipe “${recipe.title}”?`)){await api('/api/admin/recipes/'+recipe.id,{method:'DELETE'});await loadRecipes();say('Recipe deleted.');}}};
$('#newsletter-campaign-form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,m=$('#campaign-message'),b=f.querySelector('button');if(!confirm('Send this campaign to every opted-in Smoke Signal subscriber?'))return;b.disabled=true;m.textContent='Sending emails… Please keep this page open.';try{const d=await api('/api/admin/marketing/campaign',{method:'POST',body:JSON.stringify({subject:f.subject.value,message:f.message.value})});m.textContent=`Campaign complete: ${d.sent} sent, ${d.failed} failed, ${d.total} opted-in subscribers.`;f.reset();}catch(err){m.textContent=err.message;}finally{b.disabled=false;}};

