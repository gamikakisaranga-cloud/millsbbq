async function loadCategories(){if(!cache.products.length)await loadProducts();const [c,k,b]=await Promise.all([api('/api/admin/categories'),api('/api/admin/collections'),api('/api/admin/bundles')]);$('#category-list').innerHTML=c.categories.map(x=>`<div class="erp-status-item"><span>${esc(x.name)} <small>(${x.productCount} products)</small></span><b>${x.is_active?'Active':'Archived'}</b></div>`).join('')||'<p class="erp-muted">No categories created.</p>';$('#collection-list').innerHTML=k.collections.map(x=>`<div class="erp-status-item"><span>${esc(x.name)} <small>(${x.productCount} products)</small></span><b>${x.is_featured?'Featured':'Collection'}</b></div>`).join('')||'<p class="erp-muted">No collections created.</p>';$('#collection-list').insertAdjacentHTML('beforeend',b.bundles.map(x=>`<div class="erp-status-item"><span>${esc(x.name)} <small>(${x.items.length} items)</small></span><b>${x.is_active?'Active':'Draft bundle'}</b></div>`).join(''));}
async function loadDiscounts(){const d=await api('/api/admin/discounts');$('#discount-list').innerHTML=d.discounts.map(x=>`<tr><td><b>${esc(x.code)}</b></td><td>${esc(x.type)}</td><td>${x.type==='PERCENT'?x.value+'%':money(x.value)}</td><td>${money(x.minimum_order_cents)}</td><td>${x.usedCount}</td><td><button class="erp-table-action" data-discount="${x.id}" data-active="${x.is_active?0:1}">${x.is_active?'Active · disable':'Inactive · enable'}</button></td></tr>`).join('');}
