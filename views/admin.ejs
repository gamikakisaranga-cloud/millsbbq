async function go(view){$$('.erp-view').forEach(x=>x.classList.toggle('active',x.id==='view-'+view));$$('.erp-nav-item').forEach(x=>x.classList.toggle('active',x.dataset.view===view));$('#erp-heading').textContent=titles[view];$('#erp-current').textContent=view.toUpperCase();$('#erp-sidebar').classList.remove('open');try{await loaders[view]?.();}catch(e){say(e.message);}}
