$('#admin-products').onclick=async e=>{const b=e.target.closest('[data-edit-product]');if(!b)return;const p=cache.products.find(x=>x.id===b.dataset.editProduct);showDialog('Edit product',field('Product name','name','text',p.name,'required')+field('Selling price (AUD)','price','number',(p.priceCents/100).toFixed(2),'min="0" step="0.01" required')+field('Stock quantity','stock','number',p.stock,'min="0" step="1" required')+field('SKU','sku','text',p.sku||'')+field('Image URL','imageUrl','url',p.imageUrl||'')+`<div class="erp-field"><label><input type="checkbox" name="isActive" ${p.isActive?'checked':''}> Published on storefront</label></div>`,async f=>{await api('/api/admin/products/'+p.id,{method:'PATCH',body:JSON.stringify({name:f.get('name'),priceCents:Math.round(Number(f.get('price'))*100),stock:Number(f.get('stock')),sku:f.get('sku'),imageUrl:f.get('imageUrl')||null,isActive:f.has('isActive')})});await loadProducts();});};
$('#new-product').onclick=()=>showDialog('Create product',field('Product name','name')+field('Slug (optional)','slug')+field('Selling price (AUD)','price','number','0','min="0" step="0.01"')+field('Initial stock','stock','number','0','min="0" step="1"')+field('SKU','sku')+field('Description','description')+field('Image file','image','file','','accept="image/*"')+`<div class="erp-field"><label><input type="checkbox" name="isActive"> Publish immediately</label></div>`,async f=>{let imageUrl='';const file=f.get('image');if(file?.size){const s=await api('/api/admin/uploads/cloudinary-signature');const fd=new FormData();fd.append('file',file);fd.append('api_key',s.apiKey);fd.append('timestamp',s.timestamp);fd.append('folder',s.folder);fd.append('signature',s.signature);const upload=await fetch(`https://api.cloudinary.com/v1_1/${s.cloudName}/image/upload`,{method:'POST',body:fd});const result=await upload.json();if(!upload.ok)throw Error(result.error?.message||'Image upload failed');imageUrl=result.secure_url;}await api('/api/admin/products',{method:'POST',body:JSON.stringify({name:f.get('name'),slug:f.get('slug')||undefined,description:f.get('description'),priceCents:Math.round(Number(f.get('price'))*100),stock:Number(f.get('stock')),sku:f.get('sku'),imageUrl,isActive:f.has('isActive')})});await loadProducts();});
$('#stock-adjust').onclick=()=>showDialog('Inventory adjustment',`<div class="erp-field"><label>Product</label><select name="productId">${cache.products.concat([]).map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('')}</select></div><div class="erp-field"><label>Adjustment type</label><select name="type"><option>RECEIVED</option><option>REMOVED</option><option>ADJUSTMENT</option><option>DAMAGED</option><option>EXPIRED</option></select></div>${field('Quantity (for adjustment, enter new total)','quantity','number','1','min="1"')}${field('Reason','reason')}${field('Reference','reference')}`,async f=>{await api('/api/admin/inventory/adjust',{method:'POST',body:JSON.stringify({productId:f.get('productId'),type:f.get('type'),quantity:Number(f.get('quantity')),reason:f.get('reason'),reference:f.get('reference')})});await loadInventory();});
$('#new-category').onclick=()=>showDialog('New category',field('Category name','name')+field('Description','description'),async f=>{await api('/api/admin/categories',{method:'POST',body:JSON.stringify({name:f.get('name'),description:f.get('description')})});await loadCategories();});$('#new-collection').onclick=()=>showDialog('New collection',field('Collection name','name')+field('Description','description')+`<div class="erp-field"><label><input type="checkbox" name="featured"> Featured on storefront</label></div>`,async f=>{await api('/api/admin/collections',{method:'POST',body:JSON.stringify({name:f.get('name'),description:f.get('description'),isFeatured:f.has('featured')})});await loadCategories();});$('#new-bundle').onclick=()=>showDialog('Create product bundle',field('Bundle name','name')+field('Description','description')+field('Bundle price (AUD)','price','number','0','min="0.01" step="0.01"')+`<div class="erp-field"><label>Products (select one or more)</label><select name="productIds" multiple size="6">${cache.products.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('')}</select></div>`,async f=>{const productIds=[...f.getAll('productIds')];await api('/api/admin/bundles',{method:'POST',body:JSON.stringify({name:f.get('name'),description:f.get('description'),priceCents:Math.round(Number(f.get('price'))*100),productIds})});await loadCategories();});
$('#new-discount').onclick=()=>showDialog('Create discount',field('Coupon code','code')+`<div class="erp-field"><label>Discount type</label><select name="type"><option value="PERCENT">Percentage</option><option value="FIXED">Fixed amount (cents)</option><option value="FREE_SHIPPING">Free shipping</option></select></div>`+field('Value','value','number','10','min="0"')+field('Minimum order (AUD)','minimum','number','0','min="0" step="0.01"'),async f=>{await api('/api/admin/discounts',{method:'POST',body:JSON.stringify({code:f.get('code'),type:f.get('type'),value:Number(f.get('value')),minimumOrderCents:Math.round(Number(f.get('minimum'))*100)})});await loadDiscounts();});
document.addEventListener('click',async e=>{const d=e.target.closest('[data-order]');if(d){await orderDetail(d.dataset.order);return;}const c=e.target.closest('[data-customer]');if(c){const x=await api('/api/admin/customers/'+c.dataset.customer);$('#customer-detail').hidden=false;$('#customer-detail').innerHTML=`<h2>${esc(x.customer.firstName)} ${esc(x.customer.lastName)}</h2><p>${esc(x.customer.email)} · ${esc(x.customer.phone||'')}</p><h3>Order history</h3>${x.orders.map(o=>`<p>${esc(o.orderNumber)} · ${esc(o.status)} · ${money(o.totalCents)}</p>`).join('')}`;return;}const r=e.target.closest('[data-review]');if(r){await api('/api/admin/reviews/'+r.dataset.review,{method:'PATCH',body:JSON.stringify({status:r.dataset.status})});await loadReviews();say('Review moderation saved.');return;}const cp=e.target.closest('[data-discount]');if(cp){await api('/api/admin/discounts/'+cp.dataset.discount,{method:'PATCH',body:JSON.stringify({isActive:cp.dataset.active==='1'})});await loadDiscounts();}});
$('#admin-logout').onclick=async()=>{await fetch('/api/auth/logout',{method:'POST'});location.href='/account';};
const main=$('.erp-main');go(main.dataset.initialView||'overview').then(async()=>{if(main.dataset.openNew==='1')$('#new-product').click();if(main.dataset.orderId)await orderDetail(main.dataset.orderId);if(main.dataset.productId){const row=$(`[data-edit-product="${main.dataset.productId}"]`);row?.click();}if(main.dataset.customerId){const button=$(`[data-customer="${main.dataset.customerId}"]`);button?.click();}}).catch(e=>say(e.message));
})();
</script>
<%- include('partials/footer') %>
