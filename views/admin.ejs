<%- include('partials/head', { title: 'Mills ERP | Mills Smoke & Grill', description: 'Mills Smoke & Grill operations and commerce management.' }) %>
<%- include('partials/header', { page: 'admin' }) %>
<section class="erp-shell">
  <aside class="erp-sidebar" id="erp-sidebar">
    <div class="erp-brand"><span class="erp-mark">M</span><div><b>MILLS</b><small>STORE OPERATIONS</small></div></div>
    <p class="erp-nav-label">WORKSPACE</p>
    <nav id="erp-nav">
      <button class="erp-nav-item active" data-view="overview">▦ <span>Overview</span></button>
      <button class="erp-nav-item" data-view="sales">⌁ <span>Sales & analytics</span></button>
      <button class="erp-nav-item" data-view="orders">▤ <span>Orders</span></button>
      <button class="erp-nav-item" data-view="products">◈ <span>Products</span></button>
      <button class="erp-nav-item" data-view="categories">▧ <span>Categories & collections</span></button>
      <button class="erp-nav-item" data-view="inventory">▥ <span>Inventory</span></button>
      <button class="erp-nav-item" data-view="customers">♙ <span>Customers</span></button>
      <button class="erp-nav-item" data-view="discounts">％ <span>Discounts & coupons</span></button>
      <button class="erp-nav-item" data-view="reviews">☆ <span>Reviews</span></button>
      <button class="erp-nav-item" data-view="recipes">♨ <span>Recipes</span></button>
      <button class="erp-nav-item" data-view="marketing">✉ <span>Marketing</span></button>
      <button class="erp-nav-item" data-view="reports">⇩ <span>Reports & exports</span></button>
      <button class="erp-nav-item" data-view="activity">◷ <span>Activity logs</span></button>
      <button class="erp-nav-item" data-view="settings">⚙ <span>Store settings</span></button>
    </nav>
    <div class="erp-sidebar-bottom"><span class="erp-status-dot"></span> Store workspace <button id="admin-logout" type="button">Sign out ↗</button></div>
  </aside>
  <main class="erp-main" data-initial-view="<%= initialView || 'overview' %>" data-open-new="<%= typeof openNew !== 'undefined' && openNew ? '1' : '0' %>" data-order-id="<%= typeof orderId !== 'undefined' ? orderId : '' %>" data-product-id="<%= typeof productId !== 'undefined' ? productId : '' %>" data-customer-id="<%= typeof customerId !== 'undefined' ? customerId : '' %>">
    <header class="erp-topbar"><button class="erp-mobile-menu" id="erp-menu" aria-label="Toggle navigation">☰</button><div><span class="erp-breadcrumb">MILLS / <b id="erp-current">OVERVIEW</b></span><h1 id="erp-heading">Business overview</h1></div><div class="erp-top-actions"><span class="erp-live"><i></i> LIVE DATA</span><span class="erp-avatar">M</span></div></header>
    <div class="erp-content">
      <section class="erp-view active" id="view-overview">
        <div class="erp-toolbar"><div><p class="erp-muted">Your store performance at a glance.</p></div><select id="admin-period"><option value="today">Today</option><option value="7d">Last 7 days</option><option value="30d" selected>Last 30 days</option><option value="90d">Last 90 days</option><option value="year">This year</option></select></div>
        <div class="erp-kpis" id="admin-summary"><div class="erp-skeleton"></div><div class="erp-skeleton"></div><div class="erp-skeleton"></div><div class="erp-skeleton"></div></div>
        <div class="erp-grid-2"><article class="erp-panel"><div class="erp-panel-head"><div><small>REVENUE PERFORMANCE</small><h2>Sales trend</h2></div><button class="erp-link" data-go="sales">Full report ↗</button></div><div id="admin-sales-chart" class="erp-chart"></div><p id="admin-sales-empty" class="erp-muted" hidden>No paid sales in this date range.</p></article><article class="erp-panel"><div class="erp-panel-head"><div><small>FULFILMENT</small><h2>Order activity</h2></div><button class="erp-link" data-go="orders">View orders ↗</button></div><div id="overview-order-status" class="erp-status-list"></div></article></div>
        <article class="erp-panel"><div class="erp-panel-head"><div><small>RECENT TRANSACTIONS</small><h2>Latest orders</h2></div><button class="erp-link" data-go="orders">All orders ↗</button></div><div class="erp-table-wrap"><table><thead><tr><th>ORDER</th><th>CUSTOMER</th><th>DATE</th><th>PAYMENT</th><th>FULFILMENT</th><th>TOTAL</th></tr></thead><tbody id="overview-orders"></tbody></table></div></article>
      </section>
      <section class="erp-view" id="view-sales"><div class="erp-toolbar"><p class="erp-muted">Payment-confirmed sales, based on stored order and payment data.</p><a class="erp-button secondary" id="sales-export" href="/api/admin/reports/sales.csv?period=30d">Export sales CSV</a></div><div class="erp-kpis" id="sales-kpis"></div><article class="erp-panel"><div class="erp-panel-head"><div><small>DAILY BREAKDOWN</small><h2>Revenue by day</h2></div></div><div id="sales-chart-large" class="erp-chart"></div></article><article class="erp-panel"><div class="erp-panel-head"><div><small>PRODUCT PERFORMANCE</small><h2>Best sellers</h2></div></div><div class="erp-table-wrap"><table><thead><tr><th>PRODUCT</th><th>UNITS SOLD</th><th>SALES</th></tr></thead><tbody id="product-performance"></tbody></table></div></article></section>
      <section class="erp-view" id="view-orders"><div class="erp-toolbar"><input id="order-search" placeholder="Search order, customer or email…"><span class="erp-muted" id="order-count"></span></div><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>ORDER</th><th>CUSTOMER</th><th>LOCATION</th><th>PAYMENT</th><th>STATUS</th><th>TOTAL</th><th>DATE</th><th></th></tr></thead><tbody id="admin-orders"></tbody></table></div></article><div class="erp-panel" id="order-detail" hidden></div></section>
      <section class="erp-view" id="view-products"><div class="erp-toolbar"><input id="product-search" placeholder="Search product or SKU…"><button class="erp-button" id="new-product">＋ Add product</button></div><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>PRODUCT</th><th>SKU</th><th>PRICE</th><th>STOCK</th><th>STATUS</th><th>EDIT</th></tr></thead><tbody id="admin-products"></tbody></table></div></article></section>
      <section class="erp-view" id="view-categories"><div class="erp-toolbar"><p class="erp-muted">Organise products into store categories and featured collections.</p><button class="erp-button" id="new-category">＋ New category</button></div><div class="erp-grid-2"><article class="erp-panel"><div class="erp-panel-head"><div><small>CATALOGUE</small><h2>Categories</h2></div></div><div id="category-list"></div></article><article class="erp-panel"><div class="erp-panel-head"><div><small>MERCHANDISING</small><h2>Collections</h2></div><button class="erp-link" id="new-collection">＋ Collection</button> <button class="erp-link" id="new-bundle">＋ Bundle</button></div><div id="collection-list"></div></article></div></section>
      <section class="erp-view" id="view-inventory"><div class="erp-toolbar"><p class="erp-muted">Every adjustment is recorded with an actor, reason and stock movement.</p><a class="erp-button secondary" href="/api/admin/reports/inventory.csv">Export inventory</a></div><article class="erp-panel"><div class="erp-panel-head"><div><small>STOCK LEVELS</small><h2>Inventory overview</h2></div><button class="erp-button" id="stock-adjust">Adjust stock</button></div><div class="erp-table-wrap"><table><thead><tr><th>PRODUCT</th><th>SKU</th><th>ON HAND</th><th>LOW STOCK AT</th><th>UNIT COST</th><th>STATUS</th></tr></thead><tbody id="inventory-products"></tbody></table></div></article><article class="erp-panel"><div class="erp-panel-head"><div><small>AUDIT TRAIL</small><h2>Recent stock movements</h2></div></div><div class="erp-table-wrap"><table><thead><tr><th>DATE</th><th>PRODUCT</th><th>TYPE</th><th>CHANGE</th><th>REASON</th><th>BY</th></tr></thead><tbody id="inventory-history"></tbody></table></div></article></section>
      <section class="erp-view" id="view-customers"><div class="erp-toolbar"><input id="customer-search" placeholder="Search customers…"><span class="erp-muted">Customer information is private to authorised staff.</span></div><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>CUSTOMER</th><th>EMAIL</th><th>PHONE</th><th>ORDERS</th><th>JOINED</th><th></th></tr></thead><tbody id="admin-customers"></tbody></table></div></article><div id="customer-detail" class="erp-panel" hidden></div></section>
      <section class="erp-view" id="view-discounts"><div class="erp-toolbar"><p class="erp-muted">Coupon validation must also be enforced during checkout.</p><button class="erp-button" id="new-discount">＋ Create discount</button></div><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>CODE</th><th>TYPE</th><th>VALUE</th><th>MINIMUM</th><th>USES</th><th>STATUS</th></tr></thead><tbody id="discount-list"></tbody></table></div></article></section>
      <section class="erp-view" id="view-reviews"><p class="erp-muted">Only approved reviews should be displayed publicly.</p><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>PRODUCT</th><th>CUSTOMER</th><th>RATING</th><th>REVIEW</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody id="review-list"></tbody></table></div></article></section>
      <section class="erp-view" id="view-recipes"><div class="erp-toolbar"><p class="erp-muted">Create and publish smokehouse recipes with a hero image and photo gallery.</p><button class="erp-button" id="new-recipe">＋ Add recipe</button></div><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>RECIPE</th><th>PREP</th><th>COOK</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody id="recipe-list"></tbody></table></div></article></section>
      <section class="erp-view" id="view-marketing"><div class="erp-toolbar"><p class="erp-muted">Send recipes, product releases and grilling tips only to opted-in subscribers. Every campaign includes an unsubscribe link.</p><a class="erp-button secondary" href="/api/admin/marketing/subscribers.csv">Export eligible subscribers</a></div><article class="erp-panel"><div class="erp-panel-head"><div><small>CAMPAIGN</small><h2>Send a Smoke Signal</h2></div></div><form id="newsletter-campaign-form" class="form-grid"><div class="erp-field"><label>Subject</label><input name="subject" minlength="3" maxlength="180" required></div><div class="erp-field"><label>Email content</label><textarea name="message" minlength="10" maxlength="12000" required placeholder="Write your recipes, product releases or grilling tips here…"></textarea></div><button class="erp-button" type="submit">Send to opted-in subscribers</button><p id="campaign-message" class="erp-message" role="status"></p></form></article><article class="erp-panel"><div class="erp-panel-head"><div><small>SUBSCRIBERS</small><h2>Smoke Signal list</h2></div></div><div class="erp-table-wrap"><table><thead><tr><th>EMAIL</th><th>STATUS</th><th>CONSENT SOURCE</th><th>CONSENT DATE</th></tr></thead><tbody id="subscriber-list"></tbody></table></div></article></section>
      <section class="erp-view" id="view-reports"><div class="erp-grid-2"><a class="erp-report-card" href="/api/admin/reports/sales.csv?period=30d"><b>Sales report</b><span>Daily paid sales and shipping · CSV ↗</span></a><a class="erp-report-card" href="/api/admin/reports/inventory.csv"><b>Inventory valuation</b><span>On-hand stock and recorded unit cost · CSV ↗</span></a></div><article class="erp-panel"><div class="erp-panel-head"><div><small>PRODUCT PERFORMANCE</small><h2>Units and revenue</h2></div></div><div id="reports-products"></div></article></section>
      <section class="erp-view" id="view-activity"><p class="erp-muted">Administrative activity history. Audit records are not editable here.</p><article class="erp-panel"><div class="erp-table-wrap"><table><thead><tr><th>DATE</th><th>ACTOR</th><th>ACTION</th><th>ENTITY</th><th>REFERENCE</th></tr></thead><tbody id="activity-list"></tbody></table></div></article></section>
      <section class="erp-view" id="view-settings"><p class="erp-muted">Integration secrets are never returned to this page. Configure them in the server environment.</p><article class="erp-panel"><div class="erp-panel-head"><div><small>CONFIGURATION</small><h2>Store settings</h2></div></div><div id="settings-list"></div><p class="erp-muted">Email, payment and image-storage configuration status is determined by server environment variables.</p><div id="integration-status"></div></article></section>
      <p class="erp-message" id="admin-message" role="status"></p>
    </div>
  </main>
</section>
<dialog id="erp-dialog" class="erp-dialog"><form method="dialog" id="erp-dialog-form"><div class="erp-dialog-head"><h2 id="erp-dialog-title">Add item</h2><button class="erp-close" value="cancel" aria-label="Close">×</button></div><div id="erp-dialog-body"></div><div class="erp-dialog-actions"><button class="erp-button secondary" value="cancel">Cancel</button><button class="erp-button" id="erp-dialog-save" value="default">Save changes</button></div></form></dialog>
<style>
:root{--erp-bg:#0d0c0b;--erp-panel:#171512;--erp-line:#302b25;--erp-text:#f2ecdf;--erp-muted:#948a7c;--erp-red:#e8432b;--erp-gold:#d9a441}.erp-shell{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:calc(100vh - 76px);background:var(--erp-bg);color:var(--erp-text)}.erp-sidebar{background:#11100e;border-right:1px solid var(--erp-line);padding:26px 16px;display:flex;flex-direction:column;gap:22px}.erp-brand{display:flex;align-items:center;gap:12px;padding:0 8px 24px;border-bottom:1px solid var(--erp-line)}.erp-mark{width:38px;height:38px;display:grid;place-items:center;background:var(--erp-red);font:700 22px Georgia;border-radius:9px}.erp-brand b{display:block;letter-spacing:.17em;font-size:13px}.erp-brand small{display:block;color:var(--erp-muted);font-size:9px;letter-spacing:.14em;margin-top:4px}.erp-nav-label,.erp-breadcrumb,.erp-panel-head small{font:10px 'IBM Plex Mono',monospace;letter-spacing:.14em;color:var(--erp-muted)}#erp-nav{display:grid;gap:5px}.erp-nav-item{display:flex;align-items:center;gap:12px;padding:11px 12px;border:0;border-radius:8px;background:transparent;color:#b9b0a4;text-align:left;cursor:pointer;font-size:13px}.erp-nav-item span{white-space:nowrap}.erp-nav-item:hover,.erp-nav-item.active{background:#28221c;color:#fff}.erp-nav-item.active{box-shadow:inset 3px 0 var(--erp-red)}.erp-sidebar-bottom{margin-top:auto;color:var(--erp-muted);font-size:11px;padding:16px 8px;border-top:1px solid var(--erp-line)}.erp-status-dot,.erp-live i{display:inline-block;width:7px;height:7px;background:#62bd86;border-radius:50%;margin-right:7px}.erp-sidebar-bottom button{display:block;margin-top:15px;border:0;background:none;color:#e6a79b;padding:0;cursor:pointer}.erp-main{min-width:0}.erp-topbar{height:96px;border-bottom:1px solid var(--erp-line);display:flex;align-items:center;justify-content:space-between;padding:18px clamp(20px,4vw,56px)}.erp-topbar h1{font-size:24px;margin:7px 0 0;letter-spacing:-.03em}.erp-breadcrumb{font-size:9px}.erp-breadcrumb b{color:var(--erp-gold)}.erp-top-actions{display:flex;align-items:center;gap:18px}.erp-live{font:10px 'IBM Plex Mono',monospace;color:#9caa9f}.erp-avatar{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:#31271e;color:var(--erp-gold)}.erp-content{padding:28px clamp(18px,4vw,56px) 60px;display:grid;gap:18px}.erp-view{display:none;gap:18px}.erp-view.active{display:grid}.erp-toolbar,.erp-panel-head{display:flex;justify-content:space-between;align-items:center;gap:16px}.erp-muted{color:var(--erp-muted);font-size:12px}.erp-toolbar input,.erp-toolbar select{min-height:42px;min-width:210px;padding:0 13px;background:#171512;border:1px solid var(--erp-line);border-radius:8px;color:var(--erp-text)}.erp-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.erp-kpi,.erp-panel,.erp-report-card{background:var(--erp-panel);border:1px solid var(--erp-line);border-radius:12px}.erp-kpi{padding:18px}.erp-kpi span{display:block;color:var(--erp-muted);font-size:11px}.erp-kpi strong{display:block;margin-top:11px;font-size:24px;letter-spacing:-.04em}.erp-kpi small{display:block;color:#8d9e91;font-size:10px;margin-top:8px}.erp-skeleton{height:105px;border-radius:12px;background:linear-gradient(90deg,#171512,#252019,#171512);background-size:200% 100%;animation:erp-pulse 1.5s infinite}@keyframes erp-pulse{to{background-position:-200% 0}}.erp-grid-2{display:grid;grid-template-columns:1.4fr 1fr;gap:14px}.erp-panel{padding:20px;min-width:0}.erp-panel-head{margin-bottom:18px}.erp-panel-head h2{font-size:17px;margin:6px 0 0}.erp-link{border:0;background:none;color:var(--erp-gold);font-size:11px;cursor:pointer}.erp-chart{display:grid;gap:10px;max-height:320px;overflow:auto}.erp-chart-row{display:grid;grid-template-columns:86px minmax(20px,1fr) 90px;gap:10px;align-items:center;font-size:10px}.erp-chart-track{height:8px;background:#302b25;border-radius:20px;overflow:hidden}.erp-chart-bar{height:100%;background:var(--erp-red);border-radius:20px}.erp-chart-value{text-align:right;font-variant-numeric:tabular-nums}.erp-status-list{display:grid;gap:15px}.erp-status-item{display:flex;justify-content:space-between;border-bottom:1px solid var(--erp-line);padding-bottom:12px;color:#c8c0b5;font-size:12px}.erp-table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:680px;text-align:left}th{font:9px 'IBM Plex Mono',monospace;color:var(--erp-muted);letter-spacing:.1em;padding:12px;border-bottom:1px solid var(--erp-line);white-space:nowrap}td{font-size:11px;color:#d6cec2;padding:13px 12px;border-bottom:1px solid #29241f;vertical-align:middle}td small{color:var(--erp-muted)}.erp-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 15px;background:var(--erp-red);color:white;border:1px solid var(--erp-red);border-radius:7px;text-decoration:none;font-size:11px;font-weight:700;cursor:pointer}.erp-button.secondary{background:transparent;border-color:var(--erp-line);color:var(--erp-text)}.erp-button:disabled{opacity:.5;cursor:not-allowed}.erp-table-action{border:0;background:none;color:var(--erp-gold);cursor:pointer;font-size:11px}.erp-badge{display:inline-block;padding:5px 7px;border:1px solid var(--erp-line);border-radius:20px;font-size:9px;color:#d8cdbd}.erp-report-card{padding:22px;text-decoration:none;color:var(--erp-text);display:grid;gap:10px}.erp-report-card span{color:var(--erp-muted);font-size:11px}.erp-message{font-size:12px;color:var(--erp-gold);min-height:18px}.erp-dialog{width:min(580px,calc(100% - 28px));max-height:88vh;overflow:auto;background:#171512;color:var(--erp-text);border:1px solid var(--erp-line);border-radius:14px;padding:0}.erp-dialog::backdrop{background:#000b;backdrop-filter:blur(5px)}.erp-dialog form{padding:22px}.erp-dialog-head,.erp-dialog-actions{display:flex;justify-content:space-between;align-items:center;gap:12px}.erp-dialog-head h2{font-size:18px}.erp-close{background:none;border:0;color:var(--erp-text);font-size:24px;cursor:pointer}.erp-dialog-actions{justify-content:flex-end;margin-top:22px}.erp-field{display:grid;gap:6px;margin:12px 0}.erp-field label{font-size:10px;color:var(--erp-muted)}.erp-field input,.erp-field textarea,.erp-field select{width:100%;padding:11px;background:#0e0c0a;color:var(--erp-text);border:1px solid var(--erp-line);border-radius:7px}.erp-field textarea{min-height:90px}.erp-mobile-menu{display:none;background:none;border:0;color:var(--erp-text);font-size:20px}.erp-product-img{width:38px;height:38px;object-fit:cover;border-radius:6px;background:#29241f;vertical-align:middle;margin-right:9px}
@media(max-width:1050px){.erp-shell{grid-template-columns:210px minmax(0,1fr)}.erp-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.erp-shell{display:block}.erp-sidebar{display:none;position:fixed;z-index:30;inset:0 auto 0 0;width:270px;overflow:auto;box-shadow:20px 0 70px #0009}.erp-sidebar.open{display:flex}.erp-mobile-menu{display:block}.erp-topbar{height:82px;padding:14px 18px}.erp-topbar h1{font-size:19px}.erp-live{display:none}.erp-content{padding:18px 14px 40px}.erp-grid-2{grid-template-columns:1fr}.erp-kpis{gap:8px}.erp-kpi{padding:13px}.erp-kpi strong{font-size:20px}.erp-toolbar{align-items:flex-start;flex-wrap:wrap}.erp-toolbar input{min-width:100%}}
@media(prefers-reduced-motion:reduce){.erp-skeleton{animation:none}}
</style>
<script>
(()=>{
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)], money=c=>new Intl.NumberFormat('en-AU',{style:'currency',currency:'AUD'}).format((Number(c)||0)/100), esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const msg=$('#admin-message'), dialog=$('#erp-dialog');let cache={orders:[],products:[],customers:[]};
async function api(url,options={}){const r=await fetch(url,{...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});if(r.status===401||r.status===403){location.href='/account';throw Error('Not authorised');}const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Request failed');return d;}
function say(s){msg.textContent=s;}
function showDialog(title,html,onSave){$('#erp-dialog-title').textContent=title;$('#erp-dialog-body').innerHTML=html;dialog.showModal();$('#erp-dialog-form').onsubmit=async e=>{if(e.submitter?.value==='cancel')return;e.preventDefault();const b=$('#erp-dialog-save');b.disabled=true;try{await onSave(new FormData(e.currentTarget));dialog.close();say('Saved successfully.');}catch(err){say(err.message);}finally{b.disabled=false;}};}
function field(label,name,type='text',value='',extra=''){return `<div class="erp-field"><label>${label}</label><input name="${name}" type="${type}" value="${esc(value)}" ${extra}></div>`;}
function renderChart(rows,target){const max=Math.max(1,...rows.map(r=>Number(r.grossSalesCents)));$(target).innerHTML=rows.map(r=>`<div class="erp-chart-row"><span>${esc(r.day)}</span><div class="erp-chart-track"><div class="erp-chart-bar" style="width:${Math.max(1,Number(r.grossSalesCents)/max*100)}%"></div></div><b class="erp-chart-value">${money(r.grossSalesCents)}</b></div>`).join('')||'<p class="erp-muted">No sales recorded for this period.</p>';}
async function loadSummary(){const p=$('#admin-period').value,{summary}=await api('/api/admin/summary?period='+p);const items=[['Gross sales',money(summary.grossSalesCents)],['Orders',summary.orderCount],['Average order value',money(summary.averageOrderValueCents)],['Products sold',summary.productsSold],['Net merchandise sales',money(summary.netSalesBeforeRefundsCents)],['Discounts',money(summary.discountsCents)],['Net after refunds',money(summary.netAfterRefundsCents)],['Shipping collected',money(summary.shippingCents)],['Pending orders',summary.pendingOrders],['New customers',summary.newCustomers],['Total customers',summary.totalCustomers],['Low stock',summary.lowStockProducts],['Inventory value',summary.inventoryValueCents==null?'Restricted':money(summary.inventoryValueCents)],['Refunds',money(summary.refundCents)],['Cancelled orders',summary.cancelledOrders]];$('#admin-summary').innerHTML=items.map(([a,b])=>`<div class="erp-kpi"><span>${a}</span><strong>${esc(b)}</strong><small>Live database total</small></div>`).join('');$('#sales-kpis').innerHTML=items.slice(0,4).map(([a,b])=>`<div class="erp-kpi"><span>${a}</span><strong>${esc(b)}</strong></div>`).join('');}
async function loadSales(){const p=$('#admin-period').value,{report}=await api('/api/admin/reports/sales?period='+p);renderChart(report,'#admin-sales-chart');renderChart(report,'#sales-chart-large');$('#admin-sales-empty').hidden=report.length>0;$('#sales-export').href='/api/admin/reports/sales.csv?period='+p;}
async function loadProducts(){const q=encodeURIComponent($('#product-search')?.value||'');const d=await api('/api/admin/products/page?search='+q);cache.products=d.products;$('#admin-products').innerHTML=d.products.map(p=>`<tr><td>${p.imageUrl?`<img class="erp-product-img" src="${esc(p.imageUrl)}">`:''}<b>${esc(p.name)}</b></td><td>${esc(p.sku||'—')}</td><td>${money(p.priceCents)}</td><td>${p.stock}</td><td><span class="erp-badge">${p.isActive?'PUBLISHED':'DRAFT'}</span></td><td><button class="erp-table-action" data-edit-product="${esc(p.id)}">Edit</button></td></tr>`).join('')||'<tr><td colspan="6">No products found.</td></tr>';}
async function loadOrders(){const d=await api('/api/admin/orders');cache.orders=d.orders;drawOrders();const counts={};d.orders.forEach(o=>counts[o.status]=(counts[o.status]||0)+1);$('#overview-order-status').innerHTML=Object.entries(counts).map(([k,v])=>`<div class="erp-status-item"><span>${esc(k.replaceAll('_',' '))}</span><b>${v}</b></div>`).join('')||'<p class="erp-muted">No orders yet.</p>';$('#overview-orders').innerHTML=d.orders.slice(0,6).map(o=>`<tr><td><b>${esc(o.orderNumber)}</b></td><td>${esc(o.firstName)} ${esc(o.lastName)}</td><td>${new Date(o.createdAt).toLocaleDateString('en-AU')}</td><td>${esc(o.paymentProvider||'—')}</td><td>${esc(o.status)}</td><td>${money(o.totalCents)}</td></tr>`).join('');}
