<%- include('partials/head', { title: 'Reset Password | Mills Smoke & Grill', description: 'Choose a new password for your Mills Smoke & Grill account.' }) %>
<%- include('partials/header', { page: 'account' }) %>
<section class="section"><div class="container" style="max-width:560px"><div class="checkout-card"><span class="eyebrow">Account security</span><h1 class="display display--md">Choose a new password.</h1><form id="reset-form" class="form-grid"><div class="field field--full"><label for="new-password">New password</label><input id="new-password" name="password" type="password" minlength="8" autocomplete="new-password" required></div><div class="field field--full"><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" minlength="8" autocomplete="new-password" required></div><div class="field field--full"><button class="btn btn--primary" type="submit">Update password</button></div><p id="reset-message" class="muted" role="status"></p></form></div></div></section>
<script>
document.getElementById('reset-form').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,m=document.getElementById('reset-message'),p=f.elements.password.value;if(p!==document.getElementById('confirm-password').value){m.textContent='Passwords do not match.';return;}try{const r=await fetch('/api/auth/reset-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:new URLSearchParams(location.search).get('token'),password:p})});const d=await r.json();if(!r.ok)throw Error(d.error||'Unable to reset password');m.textContent=d.message;f.reset();setTimeout(()=>location.href='/account',1800);}catch(err){m.textContent=err.message;}});
</script>
<%- include('partials/footer') %>
