NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://<user>:<password>@localhost:3306/mills_smoke_grill
SESSION_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Australia/Melbourne
FREE_SHIPPING_THRESHOLD_CENTS=15000
ADYEN_ENVIRONMENT=test
ADYEN_API_URL=https://checkout-test.adyen.com/v71
ADYEN_API_KEY=your-adyen-api-key
ADYEN_CLIENT_KEY=your-adyen-client-key
ADYEN_MERCHANT_ACCOUNT=your-adyen-merchant-account
ADYEN_HMAC_KEY=your-adyen-webhook-hmac-key
ADMIN_EMAIL=admin@millssmokeandgrill.com
ADMIN_INITIAL_PASSWORD=change-this-password
DEMO_CUSTOMER_EMAIL=customer@millssmokeandgrill.com
DEMO_CUSTOMER_PASSWORD=change-this-password
# Cloudinary product image uploads (optional; keep API secret server-side)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Transactional email via Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inquiries@millsbbq.com.au
SMTP_PASS=replace-with-your-mailbox-password
MAIL_FROM=Mills Smoke & Grill <inquiries@millsbbq.com.au>
APP_URL=https://millsbbq.com.au
CONTACT_TO=inquiries@millsbbq.com.au
